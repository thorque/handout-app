.claude/
node_modules/
.env
.DS_Store
# The contents of data/, not the directory itself: git never descends into an
# excluded directory, so `data/` would make the exception below unreachable.
data/*
# The exception. The sample files are material, not runtime state: one set for
# trying the upload by hand, covering every shape the application accepts and
# the one it refuses. The rest of data/ is content, staging and incoming and
# stays out.
!data/testfiles/
# …except the two oversize files, which are hundreds of megabytes and have no
# business in a repository. `python3 data/testfiles/build.py --large` writes
# them whenever they are needed.
data/testfiles/5-refused/too-large.html
data/testfiles/5-refused/progress-300mb.html
*.tgz

# The container-wide gitignore excludes .monoceros/ everywhere (it means the
# workspace root's own Monoceros-managed directory), which would otherwise
# also swallow this project's own launch config.
!.monoceros/
!.monoceros/launch.json
