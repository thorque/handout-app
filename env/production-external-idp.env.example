# Production against an identity provider you already have: Handout in
# production, and no Keycloak at all. This is a file on the target machine:
# whether a person writes it by hand or a pipeline renders it from its secret
# store, it is the same file and the same compose. Copy it to .env next to
# compose.yaml and fill every empty value; compose refuses to start and names the one that is
# missing. The lines that already have a value are what this scenario is.
#
# COMPOSE_PROFILES is deliberately absent: that is what leaves Keycloak and its
# database out.
#
# Register the client at your provider first, as a confidential client with the
# redirect URI https://<HANDOUT_DOMAIN>/auth/callback and the post-logout
# redirect URI https://<HANDOUT_DOMAIN>/, and give everyone who may publish a role
# that reaches the ID token's `roles` claim.

# the file of Caddy site blocks to serve, relative to caddy/Caddyfile: the edge with a certificate per name
CADDY_SITES=sites/edge.caddyfile

# the host port Caddy's port 80 is published on; the ACME HTTP-01 challenge and the redirect to HTTPS need it
HTTP_PORT=80

# the host port Caddy's port 443 is published on
HTTPS_PORT=443

# the domain the publisher interface answers on, e.g. handout.example.com; a handout is <address>.<this>
HANDOUT_DOMAIN=

# the address Let's Encrypt sends expiry and policy notices to
ACME_EMAIL=

# the directory on this machine that holds the published artifacts and is backed up by copying it, e.g. /srv/handout/artifacts; the databases and Caddy's certificates are named volumes, see "What must persist, and what to back up" in docs/deployment.md
HANDOUT_ARTIFACTS_DIR=

# the password of the application's database; it ends up inside a connection URL, so it must not contain characters with a special meaning there: @ / : # in particular
POSTGRES_PASSWORD=

# the issuer of your provider as tokens carry it, e.g. https://login.example.com/realms/company
OIDC_ISSUER_URL=

# the same issuer as this machine's application reaches it; the same value unless your provider is reached differently from inside
OIDC_BACKCHANNEL_URL=${OIDC_ISSUER_URL}

# the client id registered at your provider
OIDC_CLIENT_ID=

# that client's secret
OIDC_CLIENT_SECRET=

# the value of the role your provider puts into the ID token's roles claim for everyone who may publish, e.g. publisher (see "Microsoft Entra ID" in docs/deployment.md)
OIDC_REQUIRED_ROLE=

# allow plain HTTP against the provider; false, a provider you did not install is reached over HTTPS
OIDC_ALLOW_INSECURE_HTTP=false

# signs the session cookie of the application
SESSION_SECRET=

# Secure on the cookies; true because every request the browser makes is HTTPS
SESSION_COOKIE_SECURE=true
