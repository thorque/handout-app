# Developing in a Monoceros workbench: the services are reached by their
# container hostname, not through ports published on localhost.
#
# Copy it to .env at the repository root and nothing is left to fill. The
# values are the workbench's own defaults. If you changed them in your workbench
# config, `echo $POSTGRES_URL` in the workbench shows the real one.
# Everything else is the same as in .env.example.

# the port the application listens on; Caddy reaches it here
PORT=3000

# the interface it binds; not 127.0.0.1, the Caddy container reaches it through the host's address
BIND_ADDRESS=0.0.0.0

# PostgreSQL connection string: the workbench's postgres service, reached by its container hostname
DATABASE_URL=postgresql://monoceros:monoceros@postgres:5432/monoceros

# root of the data directory, relative to the repository root, where `npm start` runs; out of git
HANDOUT_DATA_DIR=./data

# the upload ceiling in bytes (documented value: 524288000, i.e. 500 MB — not a fallback)
MAX_UPLOAD_BYTES=524288000

# the issuer as tokens carry it and the browser reaches it: Keycloak's public URL in the workbench
OIDC_ISSUER_URL=http://handout-keycloak.localhost/realms/handout

# the same realm as the application reaches it: by the keycloak container hostname
OIDC_BACKCHANNEL_URL=http://keycloak:8080/realms/handout

# the client registered in the realm
OIDC_CLIENT_ID=handout-web

# its secret, the one in keycloak/realm.json
OIDC_CLIENT_SECRET=handout-workbench-secret

# allow plain HTTP against the provider; the whole loop is plain HTTP
OIDC_ALLOW_INSECURE_HTTP=true

# signs the session cookie; a fixed value, fine for a session that ends at your own machine
SESSION_SECRET=local-development-session-secret-not-a-secret

# Secure on the cookies; false because this origin is plain HTTP
SESSION_COOKIE_SECURE=false

# used only by the test suite (test/helpers/app.js), never by the application
# itself: the connection the tests use to create and drop the throwaway
# handout_test database around each test file. The role behind it must be
# allowed to CREATE DATABASE, and the workbench's is.
POSTGRES_URL=postgresql://monoceros:monoceros@postgres:5432/monoceros
