{
  "realm": "handout",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "client": {
      "handout-web": [
        {
          "name": "publisher",
          "description": "May sign in to Handout and publish."
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "handout-web",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "enabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${HANDOUT_DOMAIN}/"
      },
      "redirectUris": ["https://${HANDOUT_DOMAIN}/auth/callback"],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "roles in the ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "handout-web",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ]
}
