{
	servers {
		trusted_proxies static private_ranges
	}
}

{$CADDY_SITE_ADDRESS} {
	# The certificate question is Caddy's alone, and this deployment does not
	# even ask it. Blocked here anyway, so that no shipped configuration
	# answers it from outside.
	handle /.handout/tls-check* {
		respond 404
	}
	handle {
		reverse_proxy {$APP_HOST}:{$APP_PORT}
	}
}
