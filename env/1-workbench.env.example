# Scenario 1: developing on Handout in the Monoceros workbench. Copy this file
# to .env at the repository root and fill it from the workbench's environment
# (the service URLs and credentials it exports); `npm start` reads it. Only the
# application's own variables are here: the workbench proxy and its Caddy are
# configured on the host, and caddy/sites/local.caddyfile is the site file that
# Caddy uses by default.

# the port the application listens on
PORT=

# the interface it binds
BIND_ADDRESS=

# PostgreSQL connection string
DATABASE_URL=

# root of the data directory
HANDOUT_DATA_DIR=

# the upload ceiling in bytes (documented value: 524288000, i.e. 500 MB — not a fallback)
MAX_UPLOAD_BYTES=

# the issuer as tokens carry it and the browser reaches it
OIDC_ISSUER_URL=

# the same realm as the application reaches it
OIDC_BACKCHANNEL_URL=

# the client registered at the provider
OIDC_CLIENT_ID=

# its secret
OIDC_CLIENT_SECRET=

# allow plain HTTP against the provider (true or false)
OIDC_ALLOW_INSECURE_HTTP=

# signs the session cookie
SESSION_SECRET=

# Secure on the cookies (true or false)
SESSION_COOKIE_SECURE=

# used only by the test suite (test/helpers/app.js), never by the application
# itself: the connection the tests use to create and drop the throwaway
# handout_test database around each test file. The role behind it must be
# allowed to CREATE DATABASE.
POSTGRES_URL=
