# The development loop: Handout runs from source on your machine (`npm start`),
# and its services (PostgreSQL, Keycloak, Caddy) run from compose.yaml.
#
# One file carries both halves, on purpose. `docker compose --env-file .env`
# reads the compose variables in the first half, and `npm start` reads the very
# same .env for the application's twelve in the second half, so a value that
# both need (the client secret, the database password) is written once. Compose
# ignores the variables it does not use and so does the application.
#
# Copy it to .env at the repository root and nothing is left to fill. Everything
# in it is a local development value in the open, the session secret included,
# for the reason keycloak/README.md gives for the realm fixture: it protects
# nothing but a database on your own machine. It is not for production:
# docs/deployment.md has the env files for that.

# ---- the services, read by compose.yaml -------------------------------------

# bring up the bundled Keycloak and its database
COMPOSE_PROFILES=keycloak

# the compose files to read: compose.dev.yaml adds PostgreSQL's published port, which only this loop uses and no deployment scenario has
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# the file of Caddy site blocks to serve, relative to caddy/Caddyfile: one bare-port site, no TLS
CADDY_SITES=sites/local.caddyfile

# the address that site answers on inside the Caddy container: a port and no host name, so that handout.localhost and every <address>.handout.localhost under it match
CADDY_SITE_ADDRESS=:80

# where Caddy reaches the application: the host, because the application runs from source there; compose.yaml gives Caddy a name for it
APP_HOST=host.docker.internal

# the host port Caddy's port 80 is published on; the sign-in is registered for handout.localhost:8080 in keycloak/realm.json
HTTP_PORT=8080

# the host port Caddy's port 443 is published on; nothing listens behind it here, it only has to be a port that is free
HTTPS_PORT=8443

# the domain the publisher interface answers on; a handout is <address>.<this>
HANDOUT_DOMAIN=handout.localhost

# the address Let's Encrypt writes to; unused here, nothing is obtained without TLS, and required because the same compose serves production
ACME_EMAIL=nobody@handout.localhost

# where the released application image keeps the published artifacts; the development loop does not start it and the application here writes to HANDOUT_DATA_DIR, but compose requires the value for every service of the file. The databases and Caddy's certificates are named volumes, `npm run dev:down -- -v` discards them
HANDOUT_ARTIFACTS_DIR=./artifacts

# the password of the database; PostgreSQL is published on 127.0.0.1:5432 for the application on your machine
POSTGRES_PASSWORD=handout

# what Keycloak runs: development mode, which needs no hostname and no TLS
KEYCLOAK_COMMAND=start-dev --import-realm

# the realm Keycloak imports: the fixture with the publishers miriam and joerg
KEYCLOAK_REALM_FILE=./keycloak/realm.json

# the public URL of Keycloak as the browser reaches it
KC_HOSTNAME=http://localhost:8081

# the password of Keycloak's own database
KC_DB_PASSWORD=keycloak

# the first administrator of the identity provider's console, at http://localhost:8081/
KC_BOOTSTRAP_ADMIN_USERNAME=admin

# that administrator's password
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# ---- the application, read by `npm start` ------------------------------------

# the port the application listens on; Caddy reaches it here
PORT=3000

# the interface it binds; not 127.0.0.1, the Caddy container reaches it through the host's address
BIND_ADDRESS=0.0.0.0

# PostgreSQL connection string: the database the compose service publishes on the host's loopback
DATABASE_URL=postgresql://handout:handout@localhost:5432/handout

# root of the data directory, relative to the repository root, where `npm start` runs; out of git
HANDOUT_DATA_DIR=./data

# the upload ceiling in bytes (documented value: 524288000, i.e. 500 MB — not a fallback)
MAX_UPLOAD_BYTES=524288000

# the issuer as tokens carry it and the browser reaches it
OIDC_ISSUER_URL=http://localhost:8081/realms/handout

# the same realm as the application reaches it: from the host, that is the published port as well
OIDC_BACKCHANNEL_URL=http://localhost:8081/realms/handout

# the client registered in the realm
OIDC_CLIENT_ID=handout-web

# its secret, the one in keycloak/realm.json
OIDC_CLIENT_SECRET=handout-workbench-secret

# allow plain HTTP against the provider; the whole loop is plain HTTP
OIDC_ALLOW_INSECURE_HTTP=true

# signs the session cookie; a fixed value, fine for a session that ends at your own machine
SESSION_SECRET=local-development-session-secret-not-a-secret

# Secure on the cookies; false because this origin is plain HTTP
SESSION_COOKIE_SECURE=false

# used only by the test suite (test/helpers/app.js), never by the application
# itself: the connection the tests use to create and drop the throwaway
# handout_test database around each test file. The role behind it must be
# allowed to CREATE DATABASE, and the compose service's is.
POSTGRES_URL=postgresql://handout:handout@localhost:5432/handout
