# Production with the bundled Keycloak. This is a file
# on the target machine: whether a person writes it by hand or a pipeline
# renders it from its secret store, it is the same file and the same compose.
# Copy it to .env next to compose.yaml and fill every empty value; compose
# refuses to start and names the one that is missing. The lines that already
# have a value are what this scenario is, and there is nothing to choose.

# bring up the bundled Keycloak and its database
COMPOSE_PROFILES=keycloak

# the file of Caddy site blocks to serve, relative to caddy/Caddyfile: the edge with a certificate per name, and Keycloak under a name of its own
CADDY_SITES=sites/edge-keycloak.caddyfile

# the host port Caddy's port 80 is published on; the ACME HTTP-01 challenge and the redirect to HTTPS need it
HTTP_PORT=80

# the host port Caddy's port 443 is published on
HTTPS_PORT=443

# the domain the publisher interface answers on, e.g. handout.example.com; a handout is <address>.<this>
HANDOUT_DOMAIN=

# the name the identity provider answers on, e.g. id.handout.example.com
KEYCLOAK_DOMAIN=

# the address Let's Encrypt sends expiry and policy notices to
ACME_EMAIL=

# the directory on this machine that holds the published artifacts and is backed up by copying it, e.g. /srv/handout/artifacts; the databases and Caddy's certificates are named volumes, see "What must persist, and what to back up" in docs/deployment.md
HANDOUT_ARTIFACTS_DIR=

# the password of the application's database; it ends up inside a connection URL, so it must not contain characters with a special meaning there: @ / : # in particular
POSTGRES_PASSWORD=

# what Keycloak runs: production mode
KEYCLOAK_COMMAND=start --import-realm

# the realm Keycloak imports: the production realm, with no users and no literal secret
KEYCLOAK_REALM_FILE=./keycloak/realm.production.json

# the public URL of Keycloak, https and the name above
KC_HOSTNAME=https://${KEYCLOAK_DOMAIN}

# the password of Keycloak's own database
KC_DB_PASSWORD=

# the first administrator of the identity provider's console; must not stay empty, compose cannot enforce it and Keycloak would start healthy with no administrator at all (see docs/deployment.md)
KC_BOOTSTRAP_ADMIN_USERNAME=

# that administrator's password, to be changed at the first sign-in; must not stay empty either
KC_BOOTSTRAP_ADMIN_PASSWORD=

# the issuer as tokens carry it and the browser reaches it, Keycloak's public URL and the realm
OIDC_ISSUER_URL=https://${KEYCLOAK_DOMAIN}/realms/handout

# the same realm as the application reaches it, inside the compose network
OIDC_BACKCHANNEL_URL=http://keycloak:8080/realms/handout

# the client registered in the realm
OIDC_CLIENT_ID=handout-web

# the secret of the handout-web client, shared by the realm import and the application
OIDC_CLIENT_SECRET=

# allow plain HTTP against the provider; true because the one plain-HTTP request here is the application's hop to Keycloak inside the compose network
OIDC_ALLOW_INSECURE_HTTP=true

# signs the session cookie of the application
SESSION_SECRET=

# Secure on the cookies; true because every request the browser makes is HTTPS
SESSION_COOKIE_SECURE=true
