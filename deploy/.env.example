# The values of a deployment. This is a file on the target machine: whether a
# person writes it by hand or a pipeline renders it from its secret store, it is
# the same file and the same compose. Copy it to .env next to compose.yaml and
# fill every value; compose refuses to start and names the one that is missing.

# the domain the publisher interface answers on, e.g. handout.example.com; a handout is <address>.<this>
HANDOUT_DOMAIN=

# the name the identity provider answers on, e.g. id.handout.example.com
KEYCLOAK_DOMAIN=

# the address Let's Encrypt sends expiry and policy notices to
ACME_EMAIL=

# the password of the application's database; it ends up inside a connection URL, so it must not contain characters with a special meaning there: @ / : # in particular
POSTGRES_PASSWORD=

# the password of Keycloak's own database
KC_DB_PASSWORD=

# the first administrator of the identity provider's console
KC_BOOTSTRAP_ADMIN_USERNAME=

# that administrator's password, to be changed at the first sign-in
KC_BOOTSTRAP_ADMIN_PASSWORD=

# the secret of the handout-web client, shared by the realm import and the application
OIDC_CLIENT_SECRET=

# signs the session cookie of the application
SESSION_SECRET=

# the one directory on this machine that holds everything that must survive and be backed up, e.g. /srv/handout
HANDOUT_STATE_DIR=
