# Production. One certificate per name, obtained by Caddy itself. Nothing here
# obtains a wildcard certificate: `*.{$HANDOUT_DOMAIN}` below is a hostname
# pattern that decides which requests a site block answers, and every name it
# matches gets a certificate of its own.
#
# Three site blocks on purpose. The two named ones get ordinary certificates at
# start; only the pattern block uses on-demand TLS, so the ask endpoint is only
# ever asked about names that could be a handout address. Putting the publisher
# origin or the identity provider through the on-demand path would deny them a
# certificate outright: the ask endpoint answers on the first label, and
# neither "handout" nor "id" is an address.
{
	# Let's Encrypt sends expiry and policy notices here.
	email {$ACME_EMAIL}

	# No trusted_proxies, unlike caddy/Caddyfile: this Caddy is the edge.
	# Trusting an incoming X-Forwarded-Host would let a client choose the
	# origin Handout derives its addresses from.

	on_demand_tls {
		# Asked before a certificate for an unknown name is obtained or
		# renewed, as GET …?domain=<the full hostname>; a 2xx allows it.
		# Straight to the application, never through a site block.
		ask http://{$APP_HOST}:{$APP_PORT}/.handout/tls-check
	}
}

# The ask endpoint is for Caddy alone. Every site block that proxies to the
# application imports this, so it is unreachable from outside.
(deny-internal-routes) {
	handle /.handout/tls-check* {
		respond 404
	}
}

{$HANDOUT_DOMAIN} {
	import deny-internal-routes
	handle {
		reverse_proxy {$APP_HOST}:{$APP_PORT}
	}
}

{$KEYCLOAK_DOMAIN} {
	# force_automate states explicitly that this hostname is automated in its
	# own right, so that it can never fall into the on-demand path of the
	# pattern block below, where the ask endpoint would refuse it (`id` is not
	# an address) and the handshake would fail. Redundant if Caddy would have
	# managed the name anyway; the failure it prevents is a dead sign-in.
	tls force_automate
	reverse_proxy {$KEYCLOAK_HOST}:{$KEYCLOAK_PORT}
}

*.{$HANDOUT_DOMAIN} {
	tls {
		on_demand
	}
	import deny-internal-routes
	handle {
		reverse_proxy {$APP_HOST}:{$APP_PORT}
	}
}
